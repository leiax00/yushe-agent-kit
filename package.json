{
  "name": "@leiax00/yushe-agent-kit",
  "version": "0.1.0",
  "description": "One-command install of skills, rules & plugins for AI coding agents (DSH, Claude Code, ...)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/plugin/index.js",
  "exports": {
    ".": "./dist/plugin/index.js",
    "./skills": "./dist/plugin/skills-entry.js",
    "./skills/locale/*.json": "./skills/locale/*.json",
    "./rules": "./dist/plugin/rules-entry.js",
    "./rules/locale/*.json": "./rules/locale/*.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "bin": {
    "yushe-agent-kit": "dist/bin/yak.js",
    "yak": "dist/bin/yak.js"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    ".agents/skills/",
    ".agents/rules/",
    "README.md",
    "locale/",
    "skills/locale/",
    "rules/locale/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin/yak.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leiax00/yushe-agent-kit.git"
  }
}
